load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@build_stack_rules_hugo//hugo:rules.bzl", "hugo_site", "hugo_theme", "hugo_serve")

hugo_theme(
    name = "book",
    srcs = [
        "@com_github_alex_shpak_hugo_book//:files",
    ],
)

hugo_site(
    name = "site_simple",
    config = "config.yaml",
    content = glob(["content/**"]),
    # These are empty globs, which are disallowed by default in Bazel 9.
    # static = glob(["static/**"]),
    # layouts = glob(["layouts/**"]),
    theme = ":book",
)

hugo_serve(
    name = "site_serve",
    dep = [":site_simple"],
)

sh_test(
    name = "site_test",
    srcs = ["site_test.sh"],
    data = [":site_simple"],
)